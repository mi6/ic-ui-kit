{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit": "npm run audit-expiry && audit-ci -m --config audit-ci.json && npm run audit --workspaces --if-present",
    "audit:bypass-expiry": "audit-ci -m --config audit-ci.json && npm run audit --workspaces --if-present",
    "audit:fix": "lerna-audit",
    "audit:update": "node update-audit.mjs",
    "audit-expiry": "node check-audit-expiry.mjs",
    "build": "npm run build --workspace=@ukic/web-components --workspace=@ukic/fonts --workspace=@ukic/docs --if-present && npm run build --workspace=@ukic/react && node scripts/combine-canary-core-readme.js",
    "build:all": "npm run build && npm run build:canary && npm run build:community",
    "build:canary": "npm run build --workspace=@ukic/canary-web-components --workspace=@ukic/canary-docs --if-present && npm run build --workspace=@ukic/canary-react && node scripts/combine-canary-core-readme.js",
    "build:community": "npm run build --workspace=@ukic/angular-community-supported",
    "build-storybook:canary-react": "npm run build-storybook --workspace=@ukic/canary-react",
    "build-storybook:canary-web-components": "npm run build-storybook --workspace=@ukic/canary-web-components",
    "build-storybook:nextjs": "npm run build-storybook --workspace=@ukic/nextjs",
    "build-storybook:react": "npm run build-storybook --workspace=@ukic/react",
    "build-storybook:web-components": "npm run build-storybook --workspace=@ukic/web-components",
    "clean": "rimraf \"packages/*/node_modules\"",
    "cypress:install:canary-react": "npm exec --workspace=@ukic/canary-react -- cypress install",
    "cypress:install:react": "npm exec --workspace=@ukic/react -- cypress install",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:spelling": "cspell --gitignore --no-must-find-files \"**/*.*\"",
    "lint-cypress": "npm run lint:cypress --workspace=@ukic/react",
    "prepare": "husky",
    "prettier": "npm run prettier --workspaces --if-present",
    "prettier:fix": "npm run prettier:fix --workspaces --if-present",
    "release-check": "lerna version --no-push --no-git-tag-version",
    "static-analysis": "npm run lint && npm run prettier && npm run audit",
    "storybook": "lerna run storybook --stream --parallel",
    "storybook:canary": "lerna run storybook --scope=@ukic/canary-* --stream --parallel",
    "test": "npm run test --workspace=@ukic/web-components",
    "test:ci": "npm run test:ci --workspace=@ukic/web-components",
    "test:coverage": "npm run test:coverage --workspace=@ukic/web-components",
    "test:coverage-ci": "npm run test:coverage-ci --workspace=@ukic/web-components",
    "test-a11y": "npm run build && npm run test-a11y --workspaces --if-present",
    "test-a11y:ci": "npm run test-a11y --workspace=@ukic/web-components",
    "test-cypress": "npm run cypress --workspace=@ukic/react",
    "test-cypress:canary": "npm run cypress --workspace=@ukic/canary-react",
    "test-cypress:canary:headless": "npm run cypress:ci --workspace=@ukic/canary-react",
    "test-cypress:ci": "npm run build && npm run test-cypress:headless",
    "test-cypress:ci:all": "npm run build:all && npm run test-cypress:headless && npm run test-cypress:canary:headless",
    "test-cypress:ci:canary": "npm run build:all && npm run test-cypress:canary:headless",
    "test-cypress:headless": "npm run cypress:ci --workspace=@ukic/react",
    "build:performance-tests": "npm run build:perf --workspace=@ukic/react",
    "test-lhci-perf:ci": "npm run build && npm run build:performance-tests && npm run test-lhci-perf:headless",
    "test-lhci-perf:headless": "npm run test:performance-lhci --workspace=@ukic/react"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/config-lerna-scopes": "^21.0.2",
    "@cspell/dict-html-symbol-entities": "^4.0.0",
    "@cspell/dict-la": "^1.0.0",
    "@cspell/dict-lorem-ipsum": "^4.0.0",
    "@cspell/dict-scientific-terms-gb": "^1.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stencil/eslint-plugin": "^1.1.0",
    "@typescript-eslint/parser": "^8.53.0",
    "audit-ci": "^6.1.0",
    "commitizen": "^4.2.4",
    "cspell": "^8.10.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^17.0.0",
    "husky": "^9.1.3",
    "lerna": "^10.0.0",
    "lerna-audit": "^1.3.3",
    "ncp": "^2.0.0",
    "prettier": "2.5.0",
    "remark-cli": "^10.0.1",
    "remark-lint": "^9.1.0",
    "remark-preset-lint-recommended": "^6.1.1",
    "rimraf": "^3.0.2",
    "storybook": "^10.4.6",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.57.1"
  },
  "_dependencyNotes": {
    "lodash": "Security override: fixes advisory requiring >=4.18.0 (transitive via commitizen/lerna). Remove once upstream deps unpin 4.17.21.",
    "picomatch": "Security override: fixes vulnerability in transitive deps (chokidar v3 / cspell). Remove once remark-cli/stylelint are upgraded.",
    "yaml": "Security override: fixes transitive vulnerability (patched in 1.10.3 / 2.8.3). Sources: lerna v6, stylelint v14.",
    "brace-expansion": "Security override: forces nx's brace-expansion (5.0.8) up to patched 5.0.9 (GHSA-rgw5-rvv9-x895). Remove once nx ships a patched transitive version."
  },
  "overrides": {
    "lodash": "^4.18.1",
    "picomatch@^2.2.1": "2.3.2",
    "picomatch@^4.0.0": "4.0.4",
    "yaml@^1.0.0": "1.10.3",
    "yaml@^2.0.0": "2.8.3",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0",
    "brace-expansion@^5.0.0": "5.0.9"
  },
  "packageManager": "^npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  }
}
